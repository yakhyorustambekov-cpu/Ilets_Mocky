# ==========================================
# IELTS Mock Testing Platform - Environment
# ==========================================

# Port to listen on (automatically assigned on Render / Heroku / Railway)
PORT=3001

# JWT Secret for user session tokens (change to a random string)
JWT_SECRET=ielts-mock-super-secure-production-secret-key-987654

# Allowed CORS client origin (use * to allow all or your custom domain)
CLIENT_URL=*

# Directory for storing test uploads
UPLOAD_DIR=./uploads

# (Optional) Database URL if using PostgreSQL (Supabase / Neon / Render Postgres)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/postgres
